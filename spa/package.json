{
  "name": "intrawatch-admin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "~4.0.18",
    "vue-tsc": "^3.3.14"
  }
}
