{
	admin off
	auto_https off
	frankenphp
	log {
		output stderr
	}
}

:3000 {
	root * /app/public
	encode zstd gzip

	route {
		# Reverb listens on loopback only. Websocket clients connect through /app; the HTTP publishing
		# API (/apps) is used by the application directly and is not exposed.
		@reverb path /app /app/*
		reverse_proxy @reverb 127.0.0.1:8080

		php_server
	}
}
