.git
.github
.superpowers/
# Release archives written by scripts/build-image.sh (its --out only allows build/ or paths outside the repository).
/build
*.oci.tar
**/*.oci.tar
**/.env
**/.env.*
!.env.example
.phpunit.result.cache
.phpunit.cache
**/node_modules
spa/dist
spa/test-results
spa/playwright-report
vendor
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
tests
docs/*
!docs/openapi.json
docker/compose.example.yml
*.md
!README.md
# The changelog API reads CHANGELOG.md and its translations at runtime.
!CHANGELOG.md
!CHANGELOG.*.md
# The manual API reads resources/manual at runtime. `*.md` above only matches root files, so this is
# already shipped; the re-include keeps it that way if the markdown rule ever widens to **/*.md.
!resources/manual/**
database/*.sqlite*
storage/app/*
storage/logs/*
storage/framework/*
